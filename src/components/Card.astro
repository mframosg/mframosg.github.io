---
interface Props {
    imgSrc: string;
    href: string;
}

const { href, imgSrc } = Astro.props;
---

<li class="link-card">
	<a href={href}>
		<img src={imgSrc} alt="Not found" class="card-image">
	</a>
</li>

<style>
.link-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    border-radius: 15px;
    text-align: center;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
    background-color: white;
    margin: 1rem;
    max-width: 280px;
}

.link-card:hover {
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
    transform: translateY(-5px);
}

.card-image {
    width: 100%;
    height: auto;
    border-radius: 15px;
}
</style>
