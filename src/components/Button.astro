---
interface Props {
    text: string;
    href: string;
}

const { href, text} = Astro.props;
---
<a class="btn" 
href = {href}>
    {text}

</a>
<style>
.btn{
	background: linear-gradient(135deg, var(--accent-dark), #f973ab);
	color: #fdf2f8;
	padding: 0.9rem 1.9rem;
	border-radius: 9999px;
	text-decoration: none;
	border: none;
	font-weight: 600;
	font-size: 0.95rem;
	letter-spacing: 0.03em;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	gap: 0.35rem;
	box-shadow: 0 12px 30px rgba(148, 27, 74, 0.4);
	transform: translateY(0);
	transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
}

.btn:hover{
	filter: brightness(1.03);
	transform: translateY(-1px) scale(1.02);
	box-shadow: 0 16px 38px rgba(148, 27, 74, 0.5);
}

.btn:active {
	transform: translateY(0) scale(0.99);
	box-shadow: 0 8px 20px rgba(148, 27, 74, 0.45);
}

@media (max-width: 640px) {
	.btn {
		width: 100%;
		justify-content: center;
	}
}
</style>
