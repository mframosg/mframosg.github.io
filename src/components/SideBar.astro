<aside>
  <a href="/" aria-label="Inicio" data-tooltip="inicio">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 9.75L12 3l9 6.75V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.75z"/>
      <path d="M9 21V12h6v9"/>
    </svg>
  </a>

  <span class="sep"></span>
  <span class="year-label">23</span>

  <a href="#momento1" aria-label="Desayuno" data-tooltip="desayuno">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18 8h1a4 4 0 0 1 0 8h-1"/>
      <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/>
      <line x1="6" y1="1" x2="6" y2="4"/>
      <line x1="10" y1="1" x2="10" y2="4"/>
      <line x1="14" y1="1" x2="14" y2="4"/>
    </svg>
  </a>

  <a href="#momento2" aria-label="Compras" data-tooltip="compras">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
      <line x1="3" y1="6" x2="21" y2="6"/>
      <path d="M16 10a4 4 0 0 1-8 0"/>
    </svg>
  </a>

  <a href="#momento3" aria-label="Almuerzo" data-tooltip="almuerzo">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 11l19-9-9 19-2-8-8-2z"/>
    </svg>
  </a>

  <a href="#momento4" aria-label="Familia" data-tooltip="familia">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
    </svg>
  </a>

  <span class="sep"></span>
  <span class="year-label">24</span>

  <a href="#momento-watch" aria-label="Apple Watch" data-tooltip="cumpleaños 24" class="link-watch">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="8"/>
      <polyline points="12 8 12 12 14.5 14.5"/>
      <line x1="12" y1="4" x2="12" y2="2"/>
      <line x1="12" y1="22" x2="12" y2="20"/>
    </svg>
  </a>

  <span class="sep"></span>
  <span class="year-label year-label--new">25</span>

  <a href="#btn-forever" aria-label="Para siempre" data-tooltip="para siempre" class="link-forever">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
    </svg>
  </a>

  <span class="sep"></span>
  <span class="year-label year-label--coming">26</span>

  <a href="#momento-26" aria-label="Próximamente" data-tooltip="próximamente" class="link-coming">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
    </svg>
  </a>
</aside>

<style>
  aside {
    position: fixed;
    left: 1.4rem;
    top: 50%;
    transform: translateY(-50%);
    padding: 0.8rem 0.6rem;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(240, 180, 200, 0.25);
    border-radius: 9999px;
    box-shadow:
      0 8px 32px rgba(192, 99, 125, 0.12),
      0 1px 4px rgba(15, 23, 42, 0.06);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    z-index: 20;
    max-height: 95svh;
  }

  /* ── icon buttons ── */
  a {
    position: relative;
    text-decoration: none;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 9999px;
    display: flex;
    justify-content: center;
    align-items: center;
    color: #c0637d;
    background: transparent;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition:
      background 0.22s ease,
      color 0.22s ease,
      transform 0.22s ease,
      box-shadow 0.22s ease;
  }

  a svg {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
  }

  a:hover,
  a:focus-visible {
    background: linear-gradient(135deg, #c0637d, #f973ab);
    color: #fff;
    transform: scale(1.08);
    box-shadow: 0 6px 18px rgba(192, 99, 125, 0.38);
    outline: none;
  }

  /* ── tooltip ── */
  a::before {
    content: attr(data-tooltip);
    position: absolute;
    left: calc(100% + 0.8rem);
    top: 50%;
    transform: translateY(-50%);
    white-space: nowrap;
    font-family: 'Poppins', sans-serif;
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: #6b4050;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(240, 180, 200, 0.4);
    border-radius: 9999px;
    padding: 0.22rem 0.65rem;
    box-shadow: 0 4px 12px rgba(192, 99, 125, 0.12);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease;
    translate: -4px 0;
  }

  a:hover::before {
    opacity: 1;
    translate: 0 0;
  }

  /* ── separator ── */
  .sep {
    display: block;
    width: 1px;
    height: 0.7rem;
    background: linear-gradient(to bottom, transparent, rgba(240, 160, 180, 0.4), transparent);
    margin: 0.05rem 0;
  }

  /* ── year labels ── */
  .year-label {
    font-family: 'Poppins', sans-serif;
    font-size: 0.55rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: #c0637d;
    opacity: 0.45;
    line-height: 1;
    user-select: none;
  }

  .year-label--new {
    color: #c9a96e;
    opacity: 0.7;
  }

  .year-label--coming {
    color: #aaa;
    opacity: 0.35;
  }

  /* ── apple watch ── */
  a.link-watch {
    color: #a0a0c0;
  }

  a.link-watch:hover {
    background: linear-gradient(135deg, #a0a0c0, #c0c0e0);
    color: #fff;
    box-shadow: 0 6px 18px rgba(160, 160, 192, 0.35);
  }

  /* ── coming soon ── */
  a.link-coming {
    color: #bbb;
    opacity: 0.5;
  }

  a.link-coming:hover {
    background: rgba(180,180,180,0.15);
    color: #999;
    box-shadow: none;
    opacity: 0.7;
  }

  /* ── para siempre: siempre con un toque especial ── */
  a.link-forever {
    color: #c9a96e;
  }

  a.link-forever:hover {
    background: linear-gradient(135deg, #c9a96e, #e8c98a);
    color: #fff;
    box-shadow: 0 6px 18px rgba(201, 169, 110, 0.4);
  }

  /* ── active dot indicator ── */
  a.active {
    background: linear-gradient(135deg, #e8a0b4, #f06292);
    color: #fff;
    box-shadow: 0 4px 14px rgba(192, 99, 125, 0.3);
  }

  /* ── mobile: bottom bar ── */
  @media (max-width: 768px) {
    aside {
      left: 50%;
      bottom: 1.2rem;
      top: auto;
      transform: translateX(-50%);
      flex-direction: row;
      padding: 0.6rem 1rem;
      gap: 0.2rem;
      border-radius: 9999px;
    }

    .sep {
      width: 1.2rem;
      height: 1px;
      background: linear-gradient(to right, transparent, rgba(240, 160, 180, 0.5), transparent);
      margin: 0 0.1rem;
    }

    a::before { display: none; }
    .year-label { display: none; }

    a svg {
      width: 1rem;
      height: 1rem;
    }
  }
</style>

<script>
  // Navegación con JS — necesario en Safari con scroll-snap activo
  // (el anchor nativo es ignorado por Safari en este contexto)
  function scrollToId(id: string) {
    const target = document.getElementById(id);
    if (!target) return;
    // scrollIntoView es más confiable que anchor nativo en Safari con scroll-snap
    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  document.querySelectorAll('aside a[href^="#"]').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      scrollToId((link as HTMLAnchorElement).getAttribute('href')!.slice(1));
    });
    // Soporte para touch en Safari — usar touchend para evitar el delay de 300ms
    link.addEventListener('touchend', (e) => {
      e.preventDefault();
      scrollToId((link as HTMLAnchorElement).getAttribute('href')!.slice(1));
    }, { passive: false });
  });

  // Marca el link activo según la sección visible
  const sections = ['momento1', 'momento2', 'momento3', 'momento4'];
  const links = document.querySelectorAll('aside a[href^="#"]');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          links.forEach((l) => l.classList.remove('active'));
          const active = document.querySelector(`aside a[href="#${entry.target.id}"]`);
          if (active) active.classList.add('active');
        }
      });
    },
    { threshold: 0.45 }
  );

  sections.forEach((id) => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });
</script>
